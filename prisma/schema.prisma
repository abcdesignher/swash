// Swash — Prisma Schema
// Source of truth for persistent application records: PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ServiceEnquiry {
  id          String   @id @default(cuid())
  fullName    String
  email       String
  serviceType String
  notes       String?
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}
