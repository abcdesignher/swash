// Swash — Prisma Schema
// Source of truth for persistent application records: PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ServiceEnquiry {
  id          String   @id @default(cuid())
  fullName    String
  email       String
  serviceType String
  notes       String?
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

model User {
  id                String    @id @default(cuid())
  fullName          String
  email             String    @unique
  phone             String
  passwordHash      String
  role              String    @default("CUSTOMER")
  preferredPlan     String
  defaultPickupZone String    @default("Lagos Mainland")
  acceptedTermsAt   DateTime  @default(now())
  emailVerifiedAt   DateTime?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sessions          Session[]
  verificationCodes VerificationCode[]
  subscriptions     Subscription[]
  orders            LaundryOrder[]
  payments          Payment[]
  paymentAttempts   PaymentAttempt[]
  emailJobs         EmailJob[]

  @@index([phone])
  @@index([role])
}

model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, revokedAt])
}

model VerificationCode {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email       String
  codeHash    String
  purpose     String    @default("EMAIL_VERIFICATION")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, purpose, usedAt])
  @@index([expiresAt])
}

model Subscription {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  planName              String
  status                String   @default("ACTIVE")
  monthlyAllowanceItems Int
  rolloverItems         Int      @default(0)
  usedItems             Int      @default(0)
  priceKobo             Int
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  orders          LaundryOrder[]
  payments        Payment[]
  paymentAttempts PaymentAttempt[]

  @@index([userId, status])
  @@index([currentPeriodEnd])
}

model LaundryOrder {
  id                  String        @id @default(cuid())
  orderNumber         String        @unique
  userId              String
  user                User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  subscriptionId      String?
  subscription        Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  status              String        @default("REQUESTED")
  itemCount           Int
  specialItemsNotes   String?
  pickupAddress       String
  scheduledPickupAt   DateTime
  collectedAt         DateTime?
  scheduledDeliveryAt DateTime?
  deliveredAt         DateTime?
  extraChargeKobo     Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  payments        Payment[]
  paymentAttempts PaymentAttempt[]

  @@index([userId, status])
  @@index([scheduledPickupAt, status])
}

model PaymentAttempt {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  subscriptionId    String?
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  orderId           String?
  order             LaundryOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  providerReference String        @unique
  amountKobo        Int
  currency          String        @default("NGN")
  channel           String?
  status            String        @default("INITIATED")
  failureCode       String?
  failureReason     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  payment Payment?

  @@index([userId, status, createdAt])
}

model Payment {
  id                    String         @id @default(cuid())
  paymentAttemptId      String         @unique
  paymentAttempt        PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  userId                String
  user                  User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  subscriptionId        String?
  subscription          Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  orderId               String?
  order                 LaundryOrder?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  providerReference     String         @unique
  receiptNumber         String         @unique
  amountKobo            Int
  currency              String         @default("NGN")
  customerEmailSnapshot String
  confirmedAt           DateTime       @default(now())

  @@index([userId, confirmedAt])
}

model KnowledgeChunk {
  id            String   @id @default(cuid())
  documentSlug  String
  sectionTitle  String
  chunkIndex    Int
  content       String
  category      String
  embeddingJson String?
  isApproved    Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  @@unique([documentSlug, chunkIndex])
  @@index([category, isApproved])
}

model EmailJob {
  id           String    @id @default(cuid())
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  toEmail      String
  subject      String
  templateType String
  payloadJson  String
  status       String    @default("PENDING")
  attempts     Int       @default(0)
  lastError    String?
  scheduledAt  DateTime  @default(now())
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([status, scheduledAt])
}
